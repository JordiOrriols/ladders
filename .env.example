# Supabase project settings (publishable key; data is protected by Row Level Security).
# Leave empty to run in local-only mode (localStorage + JSON import/export).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Absolute Planner base URL, including its deployment pathname (required in production).
# If empty on localhost/127.0.0.1 only, vacations links use http://127.0.0.1:5176.
VITE_PLANNER_URL=
